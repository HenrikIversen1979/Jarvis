# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Claude model to use
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: enable a proper Jarvis-like voice via ElevenLabs.
# Without these, the app falls back to the browser's built-in TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Port for the local server
PORT=3000
